# Copy this file to .env.local on each computer.
# Do not commit .env.local because it contains your ngrok token.

# Required for remote access outside your LAN.
NGROK_AUTHTOKEN=put-your-ngrok-authtoken-here

# Required when using the one-click script or non-interactive CLI.
ALLOWED_EMAIL=you@gmail.com

# Optional: use a stable reserved ngrok domain if your ngrok account has one.
# Example: antigravity-yourname.ngrok-free.app
NGROK_DOMAIN=

# Local proxy and Antigravity CDP ports.
PORT=5555
CDP_PORT=9223

# Safety switch for normal desktop use.
# Set to 1 to prevent the proxy from killing, restarting, starting, or opening
# Antigravity desktop windows automatically.
ANTIGRAVITY_DESKTOP_SAFE_MODE=0

# Optional: default project opened by the one-click script.
# Leave empty to open the repository folder.
ANTIGRAVITY_PROJECT_DIR=

# Optional: override Antigravity binary path if auto-detection fails.
# Windows example:
# ANTIGRAVITY_BINARY=C:\Users\you\AppData\Local\Programs\Antigravity\Antigravity.exe
ANTIGRAVITY_BINARY=
