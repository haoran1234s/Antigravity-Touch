{
  "name": "antigravity-touch",
  "version": "1.1.4",
  "description": "Chat with your Antigravity AI coding agent from any device — mobile touch controller with secure ngrok tunnel, real-time streaming, and remote approve/reject",
  "keywords": [
    "antigravity",
    "ide",
    "ai-agent",
    "ai-coding",
    "mobile",
    "remote",
    "chat",
    "proxy",
    "ngrok",
    "cdp",
    "chrome-devtools-protocol",
    "developer-tools",
    "devtools",
    "tunnel",
    "pwa",
    "sse",
    "streaming",
    "vscode",
    "electron",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/Belal33/antigravity-touch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Belal33/antigravity-touch.git"
  },
  "bugs": {
    "url": "https://github.com/Belal33/antigravity-touch/issues"
  },
  "author": "Belal",
  "license": "MIT",
  "bin": {
    "antigravity-touch": "bin/cli.js"
  },
  "files": [
    "bin/",
    "public/",
    "!public/demo.gif",
    ".next/standalone/server.js",
    ".next/standalone/.next/",
    "!.next/standalone/.next/package.json",
    "!.next/standalone/package.json",
    "!.next/package.json",
    ".next/static/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev -p 5555",
    "build": "next build --webpack",
    "postbuild": "node scripts/patch-next.js",
    "start": "next start -p 5555",
    "tunnel": "node bin/cli.js",
    "remote": "node bin/cli.js",
    "local": "node bin/cli.js --no-tunnel",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "NODE_ENV=production npm run build",
    "test:scraper": "node tests/runner.js",
    "test:scraper:ci": "node tests/runner.js --window 0 --json",
    "test:scraper:read": "node tests/runner.js --window 0 --category read",
    "test:scraper:verbose": "node tests/runner.js --window 0 --verbose"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@ngrok/ngrok": "^1.7.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.7.0",
    "next": "16.1.6",
    "puppeteer-core": "^24.39.0",
    "qrcode-terminal": "^0.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "typescript": "5.9.3"
  }
}
